<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <set>
            <objectAnimator android:propertyName="scaleX" android:valueTo="0.98" android:duration="140" android:valueType="floatType" />
            <objectAnimator android:propertyName="scaleY" android:valueTo="0.98" android:duration="140" android:valueType="floatType" />
            <objectAnimator android:propertyName="alpha" android:valueTo="0.85" android:duration="140" android:valueType="floatType" />
        </set>
    </item>
    <item>
        <set>
            <objectAnimator android:propertyName="scaleX" android:valueTo="1" android:duration="260" android:valueType="floatType" android:interpolator="@android:anim/decelerate_interpolator" />
            <objectAnimator android:propertyName="scaleY" android:valueTo="1" android:duration="260" android:valueType="floatType" android:interpolator="@android:anim/decelerate_interpolator" />
            <objectAnimator android:propertyName="alpha" android:valueTo="1" android:duration="260" android:valueType="floatType" />
        </set>
    </item>
</selector>
