<?xml version="1.0" encoding="utf-8"?>
<!-- Barre du haut : verre sombre qui apparaît au défilement -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <gradient android:angle="270" android:startColor="#F5120E14" android:endColor="#D9120E14" />
            <corners android:bottomLeftRadius="28dp" android:bottomRightRadius="28dp" />
        </shape>
    </item>
    <item>
        <shape>
            <stroke android:width="1dp" android:color="#26FFFFFF" />
            <corners android:bottomLeftRadius="28dp" android:bottomRightRadius="28dp" />
        </shape>
    </item>
</layer-list>
