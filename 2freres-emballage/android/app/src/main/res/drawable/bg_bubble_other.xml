<?xml version="1.0" encoding="utf-8"?>
<!-- Verre dépoli : remplissage translucide + reflet en haut + liseré clair -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <gradient android:angle="300" android:startColor="#26FFFFFF" android:endColor="#12FFFFFF" />
            <corners android:topLeftRadius="20dp" android:topRightRadius="20dp" android:bottomLeftRadius="6dp" android:bottomRightRadius="20dp" />
        </shape>
    </item>
    <item android:bottom="1dp">
        <shape>
            <gradient android:angle="270" android:startColor="#14FFFFFF" android:centerColor="#00FFFFFF" android:endColor="#00FFFFFF" />
            <corners android:topLeftRadius="20dp" android:topRightRadius="20dp" android:bottomLeftRadius="6dp" android:bottomRightRadius="20dp" />
        </shape>
    </item>
    <item>
        <shape>
            <stroke android:width="1dp" android:color="#2EFFFFFF" />
            <corners android:topLeftRadius="20dp" android:topRightRadius="20dp" android:bottomLeftRadius="6dp" android:bottomRightRadius="20dp" />
        </shape>
    </item>
</layer-list>
