<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="10dp"
    android:paddingBottom="10dp">

    <LinearLayout
        android:id="@+id/sheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/glass_sheet"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="22dp"
        android:paddingTop="12dp"
        android:paddingBottom="22dp">

        <View
            android:layout_width="44dp"
            android:layout_height="5dp"
            android:background="@drawable/bg_handle" />

        <FrameLayout
            android:id="@+id/updIcon"
            android:layout_width="92dp"
            android:layout_height="92dp"
            android:layout_marginTop="22dp"
            android:background="@drawable/bg_update_glow">

            <ImageView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_rocket"
                app:tint="#FFFFFF" />
        </FrameLayout>

        <TextView
            style="@style/T.Display"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:text="@string/update_title"
            android:textSize="23sp" />

        <TextView
            android:id="@+id/updSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/glass_pill"
            android:paddingHorizontal="14dp"
            android:paddingVertical="5dp"
            android:textColor="@color/gold"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/updNotes"
            style="@style/T.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/glass_tile"
            android:padding="16dp" />

        <ProgressBar
            android:id="@+id/updProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:layout_marginTop="18dp"
            android:max="100"
            android:progressDrawable="@drawable/bg_progress"
            android:visibility="gone" />

        <TextView
            android:id="@+id/updStatus"
            style="@style/T.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textSize="13sp"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/updNow"
            style="@style/GlassButton"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="18dp"
            android:text="@string/update_now"
            app:icon="@drawable/ic_download"
            app:iconGravity="textStart"
            app:iconTint="#FFFFFF" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/updLater"
            style="@style/GlassButton.Text"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="4dp"
            android:text="@string/update_later"
            android:textColor="@color/text_secondary" />
    </LinearLayout>
</FrameLayout>
