<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android" android:enterFadeDuration="250" android:exitFadeDuration="250">
    <item android:state_selected="true">
        <layer-list>
            <item><shape><solid android:color="#26C9A96E" /><corners android:radius="10dp" /></shape></item>
            <item><shape><stroke android:width="0.8dp" android:color="#C9A96E" /><corners android:radius="10dp" /></shape></item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item><shape><solid android:color="#0FFFFFFF" /><corners android:radius="10dp" /></shape></item>
            <item><shape><stroke android:width="0.8dp" android:color="#24FFFFFF" /><corners android:radius="10dp" /></shape></item>
        </layer-list>
    </item>
</selector>
