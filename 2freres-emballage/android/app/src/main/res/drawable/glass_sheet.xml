<?xml version="1.0" encoding="utf-8"?>
<!-- Verre fumé : remplissage translucide, reflet discret en haut, liseré fin -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <gradient android:angle="270" android:startColor="#FF1B1917" android:endColor="#FF100F0D" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <item>
        <shape>
            <gradient android:angle="270" android:startColor="#0FFFFFFF" android:centerColor="#00FFFFFF" android:endColor="#00FFFFFF" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <item>
        <shape>
            <stroke android:width="0.8dp" android:color="#2EFFFFFF" />
            <corners android:radius="20dp" />
        </shape>
    </item>
</layer-list>
