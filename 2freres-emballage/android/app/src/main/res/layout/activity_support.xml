<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.deuxfreres.emballage.AuroraView
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

    <LinearLayout
        android:id="@+id/headerBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/glass_header"
        android:orientation="vertical"
        android:paddingBottom="4dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            style="@style/GlassToolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="@drawable/ic_back"
            app:navigationContentDescription="@string/back"
            app:title="@string/support" />
    </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:paddingVertical="10dp" />

            <TextView
                android:id="@+id/empty"
                style="@style/T.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_margin="32dp"
                android:background="@drawable/glass_card"
                android:gravity="center"
                android:padding="24dp"
                android:text="@string/support_empty"
                android:visibility="gone" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/inputBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:paddingTop="6dp"
            android:paddingBottom="12dp">

            <EditText
                android:id="@+id/input"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_input"
                android:hint="@string/support_hint"
                android:importantForAutofill="no"
                android:inputType="textMultiLine|textCapSentences"
                android:maxLength="2000"
                android:maxLines="5"
                android:minHeight="52dp"
                android:paddingHorizontal="18dp"
                android:paddingVertical="12dp"
                android:textColor="#FFFFFF"
                android:textColorHint="@color/text_muted" />

            <ImageButton
                android:id="@+id/send"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginStart="8dp"
                android:autoMirrored="true"
                android:background="@drawable/bg_send"
                android:contentDescription="@string/send"
                android:elevation="6dp"
                android:src="@drawable/ic_send"
                app:tint="#FFFFFF" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
