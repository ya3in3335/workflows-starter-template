<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.App" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/brand</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorPrimaryContainer">#3A1F2A</item>
        <item name="colorSecondary">@color/gold</item>
        <item name="colorSecondaryContainer">#2E2618</item>
        <item name="colorSurface">#1A151C</item>
        <item name="colorOnSurface">#FFFFFF</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="android:windowBackground">@drawable/bg_app</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:enforceNavigationBarContrast" tools:targetApi="29" xmlns:tools="http://schemas.android.com/tools">false</item>
        <item name="android:windowActivityTransitions">true</item>
        <item name="android:windowAnimationStyle">@style/GlassActivityAnim</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColorHint">@color/text_muted</item>
        <item name="alertDialogTheme">@style/GlassDialog</item>
        <item name="materialAlertDialogTheme">@style/GlassDialog</item>
        <item name="bottomSheetDialogTheme">@style/GlassSheet</item>
    </style>

    <style name="Theme.App.Splash" parent="Theme.App">
        <item name="android:windowBackground">@drawable/bg_splash</item>
        <item name="android:statusBarColor">#1A1617</item>
        <item name="android:navigationBarColor">#1A1617</item>
    </style>

    <!-- Fiche produit : l'image « vole » depuis la carte (élément partagé) -->
    <style name="Theme.App.Detail" parent="Theme.App">
        <item name="android:windowSharedElementEnterTransition">@transition/hero</item>
        <item name="android:windowSharedElementReturnTransition">@transition/hero</item>
        <item name="android:windowEnterTransition">@transition/fade_in</item>
        <item name="android:windowReturnTransition">@transition/fade_in</item>
    </style>

    <!-- Transitions entre écrans : montée + fondu + léger zoom -->
    <style name="GlassActivityAnim" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/screen_open_enter</item>
        <item name="android:activityOpenExitAnimation">@anim/screen_open_exit</item>
        <item name="android:activityCloseEnterAnimation">@anim/screen_close_enter</item>
        <item name="android:activityCloseExitAnimation">@anim/screen_close_exit</item>
    </style>

    <style name="GlassDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="android:windowBackground">@drawable/glass_dialog</item>
        <item name="colorPrimary">@color/brand</item>
        <item name="colorSurface">#1F1922</item>
        <item name="android:textColorPrimary">#FFFFFF</item>
    </style>

    <style name="GlassSheet" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/GlassSheetStyle</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:backgroundDimAmount">0.55</item>
    </style>
    <style name="GlassSheetStyle" parent="Widget.Material3.BottomSheet.Modal">
        <item name="backgroundTint">@android:color/transparent</item>
        <item name="android:background">@android:color/transparent</item>
    </style>

    <!-- Textes -->
    <style name="T" parent="">
        <item name="android:textColor">@color/text_primary</item>
    </style>
    <style name="T.Display">
        <item name="android:textSize">28sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>
    <style name="T.Title">
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="T.Body">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:lineSpacingExtra">3dp</item>
    </style>
    <style name="T.Caption">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/text_muted</item>
    </style>

    <!-- Bouton dégradé principal -->
    <style name="GlassButton" parent="Widget.Material3.Button">
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">18dp</item>
        <item name="backgroundTint">@null</item>
        <item name="android:background">@drawable/bg_gradient_primary</item>
        <item name="android:stateListAnimator">@animator/press_scale</item>
    </style>
    <style name="GlassButton.Outline" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">18dp</item>
        <item name="strokeColor">@color/glass_stroke</item>
        <item name="backgroundTint">#14FFFFFF</item>
        <item name="android:stateListAnimator">@animator/press_scale</item>
    </style>
    <style name="GlassButton.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">@color/brand</item>
    </style>

    <style name="GlassToolbar">
        <item name="android:background">@android:color/transparent</item>
        <item name="titleTextColor">#FFFFFF</item>
        <item name="subtitleTextColor">@color/text_secondary</item>
        <item name="navigationIconTint">#FFFFFF</item>
    </style>
    <style name="Shape.Image" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">17dp</item>
    </style>
    <style name="Shape.Hero" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeBottomLeft">32dp</item>
        <item name="cornerSizeBottomRight">32dp</item>
        <item name="cornerSizeTopLeft">0dp</item>
        <item name="cornerSizeTopRight">0dp</item>
    </style>
    <style name="GlassField" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">#14FFFFFF</item>
        <item name="boxStrokeColor">@color/brand</item>
        <item name="boxCornerRadiusTopStart">18dp</item>
        <item name="boxCornerRadiusTopEnd">18dp</item>
        <item name="boxCornerRadiusBottomStart">18dp</item>
        <item name="boxCornerRadiusBottomEnd">18dp</item>
        <item name="hintTextColor">@color/brand</item>
        <item name="android:textColorHint">@color/text_muted</item>
        <item name="startIconTint">@color/text_secondary</item>
        <item name="endIconTint">@color/text_secondary</item>
    </style>
</resources>
