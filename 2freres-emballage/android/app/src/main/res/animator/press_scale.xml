<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <set>
            <objectAnimator android:propertyName="scaleX" android:valueTo="0.95" android:duration="120" android:valueType="floatType" />
            <objectAnimator android:propertyName="scaleY" android:valueTo="0.95" android:duration="120" android:valueType="floatType" />
        </set>
    </item>
    <item>
        <set>
            <objectAnimator android:propertyName="scaleX" android:valueTo="1" android:duration="380" android:valueType="floatType"
                android:interpolator="@android:anim/overshoot_interpolator" />
            <objectAnimator android:propertyName="scaleY" android:valueTo="1" android:duration="380" android:valueType="floatType"
                android:interpolator="@android:anim/overshoot_interpolator" />
        </set>
    </item>
</selector>
